{
  // Typechecking and running from source, with no build in the way. `tsx` uses
  // these paths so `npm test` needs no `lib/`, and this is the only config that
  // ever looks at `test/`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "baseUrl": ".",
    // Listed one by one on purpose: a `@pterodocs/core/*` wildcard maps to a
    // directory, and neither Node nor tsx does directory-index resolution for
    // a mapped path.
    "paths": {
      "@pterodocs/core": ["packages/core/src/index.ts"],
      "@pterodocs/core/model": ["packages/core/src/model/index.ts"],
      "@pterodocs/core/render": ["packages/core/src/render/index.ts"],
      "@pterodocs/core/target": ["packages/core/src/target/index.ts"],
      "@pterodocs/core/util": ["packages/core/src/util/index.ts"],
      "@pterodocs/docusaurus": ["packages/docusaurus/src/index.ts"],
      "@pterodocs/wordpress": ["packages/wordpress/src/index.ts"],
      "pterodocs": ["packages/cli/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "scripts"],
  // The documentation site is a Docusaurus site, not a package this builds:
  // it has JSX, the DOM and its own tsconfig, none of which this program has.
  // `node_modules` is restated because naming `exclude` replaces the default.
  "exclude": ["node_modules", "packages/docs"]
}
